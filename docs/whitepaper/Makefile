# Build the white paper. Everything the document quotes -- numbers, tables,
# figures, the appendix catalogue -- is generated by one of the targets below
# and written into generated/ or figures/, so no figure in the PDF was typed
# by hand and none can quietly go stale.
#
#   make            everything, then the PDF
#   make quick      the PDF from what is already generated
#   make bench      re-measure (minutes)
#
# The PDF is built inside the TeX Live image; nothing but docker is needed on
# the host for that step.

ROOT    := $(shell git rev-parse --show-toplevel)
UV      := uv run --project $(ROOT)
DOCKER  := docker run --rm -v $(ROOT):/work -w /work/docs/whitepaper \
             --user $(shell id -u):$(shell id -g) -e HOME=/tmp texlive/texlive:latest
SIZES   := 320x240 640x480 1280x720

.PHONY: all quick media bench figures diagrams capture catalogue legacy pdf fonts clean distclean

all: media catalogue bench figures diagrams capture legacy pdf

quick: catalogue pdf

# --- generated inputs ------------------------------------------------------ #

media:
	$(UV) python synth.py --width 320  --height 240 --frames 900
	$(UV) python synth.py --width 640  --height 480 --frames 300
	$(UV) python synth.py --width 1280 --height 720 --frames 150

bench: media
	$(UV) python bench.py

figures: media
	PYTHONPATH=$(CURDIR):$(ROOT) $(UV) python figures.py

diagrams:
	$(UV) --with cairosvg python diagrams.py

# Needs the gui extra and the configs bench.py writes.
capture: bench
	$(UV) --extra gui python capture.py

catalogue:
	$(UV) python catalogue.py

# The predecessor comparison: both trees live in legacy/, see its README.
legacy:
	$(UV) python legacy_diff.py

# --- the document ---------------------------------------------------------- #

# catalogue is a prerequisite on purpose: the appendix's claim is that it cannot
# drift from the registry, and regenerating it here is what makes that true.
pdf: catalogue
	$(DOCKER) latexmk -lualatex -interaction=nonstopmode -halt-on-error main.tex

# Libertinus lives in the TeX Live image; the diagrams are rendered on the host
# and need it there too, or their text is substituted and stops matching.
fonts:
	mkdir -p $$HOME/.fonts
	docker run --rm -v $$HOME/.fonts:/out texlive/texlive:latest \
	  sh -c 'cp /usr/local/texlive/*/texmf-dist/fonts/opentype/public/libertinus-fonts/*.otf /out/'
	fc-cache -f

clean:
	$(DOCKER) latexmk -C main.tex
	rm -rf out

# Also drops the generated media and figures. `make all` puts them back.
distclean: clean
	rm -rf media generated figures
